# Supabase (públicas: se usan en el navegador)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# OpenAI (solo servidor, nunca se expone al navegador)
OPENAI_API_KEY=sk-proj-xxx
# Modelo de chat con llamadas a funciones (cámbialo sin tocar código)
OPENAI_MODEL=gpt-5.4-mini
# Modelo de transcripción para el micrófono
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Opcional: secreto para firmar las confirmaciones del asistente (HMAC)
AGENT_APPROVAL_SECRET=

# Bot de Telegram (opcional). Sin n8n: el bot habla directo con el asistente.
# 1) Crea el bot con @BotFather y pega el token.
TELEGRAM_BOT_TOKEN=
# 2) Cadena aleatoria larga; Telegram la manda en cada webhook y la app la verifica.
TELEGRAM_WEBHOOK_SECRET=
# 3) Tu chat id (el bot te lo dice al escribirle). Varios separados por coma.
TELEGRAM_ALLOWED_CHAT_IDS=
# URL pública de la app, para que el servidor cargue la cabecera de los PDF que manda por Telegram.
APP_BASE_URL=https://tu-dominio.com

# Correos a clientes (Resend). Sin clave, la app funciona pero no envía.
RESEND_API_KEY=
# Remitente verificado en Resend (dominio con SPF/DKIM). Si se omite, usa nombre y correo de Ajustes. Todo sale como JAM Tech.
EMAIL_FROM=JAM Tech <facturacion@jamtech.cloud>
# MODO PRUEBA: si está definida, TODOS los correos se desvían a esta dirección (el destinatario real va en el asunto)
EMAIL_TEST_TO=
# Copia oculta de cada correo enviado, para tener constancia
EMAIL_BCC=
