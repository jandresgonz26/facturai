# Supabase (públicas: se usan en el navegador)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# OpenAI (solo servidor, nunca se expone al navegador)
OPENAI_API_KEY=sk-proj-xxx
# Modelo de chat con llamadas a funciones (cámbialo sin tocar código)
OPENAI_MODEL=gpt-5.4-mini
# Modelo de transcripción para el micrófono
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Opcional: secreto para firmar las confirmaciones del asistente (HMAC)
AGENT_APPROVAL_SECRET=
